# Outfit Agent - Environment Configuration
#
# Kopieer dit naar .env en pas aan als het moet
# .env NOOIT committen (staat in .gitignore)
# Zonder .env werkt het ook, dan zijn het de poorten hieronder

# Poort van de website op je pc
FRONTEND_PORT=8080

# Poort van de API op je pc
BACKEND_PORT=5000

# Nog geen secrets nodig. Komen die er (bv. voor Azure), dan in .env en niet in de code.
